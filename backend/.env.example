# Copy to .env for local development. Never commit .env.

# Dev and test databases (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://localhost:5432/leave
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/leave_test

# Required: the app refuses to start without these two.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Company join code for employee signup
SIGNUP_CODE=change-me

# Cheap Argon2 parameters for tests only. Never set to true in production.
PASSWORD_HASH_FAST=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Production (set these in the host's dashboard, never in a file) ---
# DATABASE_URL: paste the host database's connection string as given. A
#   postgres:// or postgresql:// URL is rewritten to postgresql+psycopg://
#   at startup, and a trailing ?sslmode=require is kept (Neon needs it).
# SECRET_KEY: a new random value, different from local (generator above).
# SIGNUP_CODE: the join code you hand to employees; not the local one.
# PASSWORD_HASH_FAST: leave unset (false) in production.
# CORS_ORIGINS: the deployed frontend origin, e.g. https://<your-site>.onrender.com
#   (no trailing slash). Not needed until the frontend is deployed.
# Python: pin the host to 3.12 (PYTHON_VERSION=3.12.x), same as local.
# Build:  pip install -r requirements.txt
# Start:  alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port $PORT
