# Copy to .env for local development. Only this file is tracked.

# Base URL of the backend API. Default: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Production: set VITE_API_BASE_URL in the host's static-site settings to the backend
# URL (no trailing slash). Vite bakes it in at build time, so rebuild if it changes.
